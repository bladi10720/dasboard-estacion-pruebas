# Copiar este archivo a secrets.toml en la misma carpeta (.streamlit/secrets.toml).
# secrets.toml está en .gitignore: no lo subas a GitHub si el repo es público.
#
# URL de exportación CSV de Google Sheets (Archivo → Compartir → enlace de lector):
# https://docs.google.com/spreadsheets/d/TU_ID_DE_HOJA/export?format=csv&gid=0

SHEETS_CSV_URL = "https://docs.google.com/spreadsheets/d/REEMPLAZA_ID/export?format=csv&gid=0"

# Comisiones (otra hoja/pestaña o spreadsheet distinto).
# Debe ser también una exportación CSV.
COMMISSIONS_CSV_URL = "https://docs.google.com/spreadsheets/d/REEMPLAZA_ID_COMISIONES/export?format=csv&gid=0"

# Opcional: misma URL en sección anidada (usa una u otra, no hace falta duplicar)
# [sheets]
# csv_url = "https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=0"

# Opcional: comisiones en sección anidada
# [commissions]
# csv_url = "https://docs.google.com/spreadsheets/d/.../export?format=csv&gid=0"
